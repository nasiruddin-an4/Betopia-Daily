# Betopia ERP e-commerce API (server-side only — never prefix these with NEXT_PUBLIC_)
CRM_API_URL=https://dev.erp.betopialimited.com/api/ecom/v1
CRM_API_KEY=

# Optional: only these email domains may place orders (comma-separated)
ALLOWED_EMAIL_DOMAINS=betopiagroup.com

# ERP employee profile API key (used by /api/erp-profile and /api/erp-eligibility)
NEXT_PUBLIC_ERP_API_KEY=
